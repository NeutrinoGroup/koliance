# Server Configuration
PORT=8080
ENVIRONMENT=development

# Supabase Postgres Database URL
DATABASE_URL=postgresql://postgres:your_password@db.your-project.supabase.co:5432/postgres

# Steam Web API
STEAM_API_KEY=your_steam_api_key_here
STEAM_DOMAIN=your_domain.com

# Alpaca Paper Trading API (Equities & Derivatives)
ALPACA_API_KEY=your_alpaca_key_id_here
ALPACA_API_SECRET=your_alpaca_secret_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets/v2

# Stripe Sandbox / Test Mode
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Pyth Network Hermes Oracle (Public API, no key required)
PYTH_HERMES_URL=https://hermes.pyth.network

# Monad Network
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
KOLIANCE_CONTRACT_ADDRESS=0x32fDd6B096EE14246b5b6971135286Bad01F4928

# Operator Security & Access Control
# Operator bearer token (KOLIANCE_API_TOKEN) for protected endpoints (e.g. /batch-settle)
KOLIANCE_API_TOKEN=
# Allowed origins for API CORS protection (comma separated, no wildcards)
CORS_ALLOWED_ORIGINS=https://koliance.oodai.space,https://koliance.vercel.app,http://localhost:3000
# Allow unauthenticated browser paper-trading writes on Alpaca endpoints (default false)
DEMO_PUBLIC_TRADING=false

# Liquidator Bot Configuration (cmd/liquidator)
LIQUIDATOR_RPC=https://testnet-rpc.monad.xyz
LIQUIDATOR_WS=wss://testnet-rpc.monad.xyz
LIQUIDATOR_CHAIN_ID=10143
LIQUIDATOR_POSITION_MANAGER=0x82040c06da6efc60e9505f2efee0099e909b15c5
LIQUIDATOR_DEMO_ORACLE=0x84e16cE1389D009A250510c6cFa13f36863430b7
LIQUIDATOR_FEED=demo
LIQUIDATOR_HERMES_URL=https://hermes.pyth.network
LIQUIDATOR_PRIVATE_KEY=

