# Koliance Next.js Frontend Environment Variables

# Koliance Contract Addresses on Monad Testnet (Chain ID 10143)
NEXT_PUBLIC_KOLIANCE_ADDRESS=0x32fDd6B096EE14246b5b6971135286Bad01F4928
NEXT_PUBLIC_KOL_TOKEN_ADDRESS=0x4cadb6f0e1b83ccb7207db4786b2a1500f066328

# Perp module — deployed and seeded contracts on Monad Testnet
NEXT_PUBLIC_PERP_USDC=0x8a5008E2755A428d914cA13E92E6bB91123Bb5FC
NEXT_PUBLIC_PERP_ORACLE=0x84e16cE1389D009A250510c6cFa13f36863430b7
NEXT_PUBLIC_PERP_VAULT=0x9c32622699394ac1493d5b76ab96c04068c806d7
NEXT_PUBLIC_PERP_POSITION_MANAGER=0x82040c06da6efc60e9505f2efee0099e909b15c5
SESSION_KEY_REGISTRY=0xCb7f48F455a19778fC75afb0564aaA88b64FA004


# Optional: point /perp at a local Hardhat node instead of Monad testnet (default).
# Run `npx hardhat node` + `npx hardhat run scripts/demo-seed.ts --network localhost`
# in contracts/, paste the printed addresses above, then set:
# NEXT_PUBLIC_PERP_CHAIN=local
# NEXT_PUBLIC_PERP_RPC_URL=http://127.0.0.1:8545
# NEXT_PUBLIC_PERP_CHAIN_ID=31337
# Hardhat account #0's well-known PUBLIC test key, so the page signs without a wallet.
# Only honoured when NEXT_PUBLIC_PERP_CHAIN=local. Never put a real key here.
# NEXT_PUBLIC_PERP_LOCAL_DEV_KEY=

# Authentication (Client-side) — read by src/lib/authConfig.ts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Optional Privy App ID (from https://dashboard.privy.io) for embedded social wallets and unified auth
NEXT_PUBLIC_PRIVY_APP_ID=
# Extra origins (exact match, comma separated) the GitHub OAuth callback may
# relay back to, on top of koliance.oodai.space / koliance.vercel.app /
# localhost:3000. Wildcards such as *.vercel.app are ignored on purpose.
NEXT_PUBLIC_OAUTH_RELAY_ORIGINS=

# Server Authentication & Security (PR #46 — required in production, fail-closed)
# Session secret for HMAC-SHA256 signature verification (MUST be at least 32 characters)
# Generate via: openssl rand -hex 32
KOLIANCE_SESSION_SECRET=
# Allowed origins for API CORS protection (comma separated, no wildcards)
KOLIANCE_ALLOWED_ORIGINS=https://koliance.oodai.space,https://koliance.vercel.app
NEXT_PUBLIC_SITE_URL=https://koliance.oodai.space

# Server OAuth & Database Secrets (Server-side only — never expose to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_SECRET=

# Go Backend Service URL (Go 网关服务地址)
# 本地开发 (Local Development):
#   默认为 http://localhost:8080，本地启动 Go 后端后即可连通；若 Go 后端未启动将提示「后端不可达 (unreachable)」。
# 生产部署 (Production / Vercel Deployment):
#   必须配置为线上公网 HTTPS 域名（例如 https://koliance-backend.onrender.com）。
#   警告：切勿在生产环境照抄 localhost:8080 或留空，否则前端行情模块将识别为「Go 网关未配置 (gateway-unconfigured)」并拒绝请求。
NEXT_PUBLIC_GO_BACKEND_URL=http://localhost:8080
